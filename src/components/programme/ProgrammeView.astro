---
import Icon, { type IconName } from "../Icon.astro";
import {
  type Edition,
  type Talk,
  type Topic,
  formatTime,
  rowsOf,
  speakersOf,
  talksOf,
  topicLabels,
} from "../../data/editions";

interface Props {
  edition: Edition;
}

const { edition } = Astro.props;

const topicIcons: Record<Topic, IconName> = {
  discovery: "lightbulb",
  cloud: "cloud",
  security: "lock",
  ai: "chip",
  infra: "server",
  data: "database",
  observability: "gauge",
  hardware: "cpu",
  tooling: "gear",
  web: "smartphone",
};

const rows = rowsOf(edition);
const talks = talksOf(edition);
const totalTalks = talks.filter((t) => t.speakers.length > 0).length;

const talkId = (t: Talk) => `${t.start}-${t.room ?? "all"}`.replace(":", "");
const dt = (time: string) => `${edition.date}T${time}`;
const minutes = (s: string, e: string) => {
  const m = (t: string) => Number(t.slice(0, 2)) * 60 + Number(t.slice(3));
  return m(e) - m(s);
};
---

<div
  data-programme
  data-year={edition.year}
  data-date={edition.date}
  class="programme"
>
  <p class="text-sm text-plum-950/60 print:hidden">
    {totalTalks} talks · {speakersOf(edition).length} speakers · {edition.rooms.length} salles
  </p>

  <!-- Schedule -->
  <ol class="mt-6 flex flex-col gap-3">
    {
      rows.map((row) => {
        const end = row.plenary?.end ?? row.parallel.reduce((m, t) => (t.end > m ? t.end : m), row.start);
        return (
          <li data-row data-start={row.start} data-end={end} class="row grid gap-2 md:grid-cols-[6rem_1fr] md:gap-4">
            <div class="flex items-baseline gap-1.5 pt-1 text-plum-700 md:sticky md:top-24 md:flex-col md:items-end md:gap-0 md:self-start md:pt-4 md:text-right">
              <time datetime={dt(row.start)} class="text-lg font-bold md:text-xl">
                {formatTime(row.start)}
              </time>
              <span class="text-sm text-plum-950/50">
                <span class="md:hidden">– </span>
                <time datetime={dt(end)}>{formatTime(end)}</time>
              </span>
              <span data-now-badge hidden class="ml-2 rounded-full bg-lilac-400 px-2 py-0.5 text-xs font-bold text-white md:mt-2 md:ml-0">
                En cours
              </span>
            </div>

            <div>
              {row.plenary?.kind === "break" && (
                <div data-break class="flex items-center justify-between gap-4 rounded-2xl border border-dashed border-plum-300 px-5 py-4 text-plum-800">
                  <p class="text-sm font-bold tracking-wider uppercase">{row.plenary.title}</p>
                  <p class="text-xs text-plum-950/50">{minutes(row.plenary.start, row.plenary.end)} min</p>
                </div>
              )}

              {(() => {
                const list: Talk[] = row.plenary?.kind === "talk" ? [row.plenary] : row.parallel;
                if (list.length === 0) return null;
                return (
                  <div class:list={["parallel grid gap-3", list.length > 1 && "md:grid-cols-2"]}>
                    {list.map((t) => {
                      const ownTime = t.end !== end;
                      // Keynotes and plenary sessions get the full-width purple card
                      const featured = t.keynote || t.room === undefined;
                      const inRoom = t.room !== undefined;
                      const id = talkId(t);
                      return (
                        <article
                          data-talk
                          data-id={id}
                          data-room={t.room ?? "all"}
                          data-topic={t.topic ?? ""}
                          data-advanced={t.advanced ? "" : undefined}
                          class:list={[
                            "talk group/talk relative flex flex-col rounded-3xl p-5 transition sm:p-6",
                            featured
                              ? "bg-plum-600 text-white"
                              : "bg-white ring-1 ring-plum-900/5 hover:ring-plum-200",
                          ]}
                        >
                          {(t.keynote || t.topic || t.advanced || inRoom) && (
                            <div class="flex flex-wrap items-center gap-1.5 pr-10 text-xs font-semibold">
                              {t.keynote && <span class="rounded-full bg-white/15 px-2.5 py-1">Keynote</span>}
                              {inRoom && (
                                <span
                                  class:list={[
                                    "inline-flex items-center gap-1 rounded-full px-2.5 py-1 ring-1 ring-inset",
                                    featured ? "ring-white/40" : "text-plum-700 ring-plum-200",
                                  ]}
                                >
                                  <Icon name="map-pin" class="size-3.5" />
                                  {edition.rooms[t.room!]}
                                </span>
                              )}
                              {t.topic && (
                                <span
                                  class:list={[
                                    "inline-flex items-center gap-1 rounded-full px-2.5 py-1",
                                    t.keynote ? "bg-white/15" : "bg-plum-50 text-plum-700",
                                  ]}
                                >
                                  <Icon name={topicIcons[t.topic]} class="size-3.5" />
                                  {topicLabels[t.topic]}
                                </span>
                              )}
                              {t.advanced && (
                                <span class="inline-flex items-center gap-1 rounded-full bg-orange-50 px-2.5 py-1 text-orange-700">
                                  <Icon name="flame" class="size-3.5" />
                                  Avancé
                                </span>
                              )}
                            </div>
                          )}
                          {t.speakers.length > 0 && (
                              <label
                                class:list={[
                                  "group/fav absolute top-3 right-3 grid size-10 shrink-0 cursor-pointer place-items-center rounded-full transition has-focus-visible:outline-2 has-focus-visible:outline-lilac-400 print:hidden",
                                  featured
                                    ? "text-white/60 hover:text-white has-checked:text-amber-300"
                                    : "text-plum-300 hover:text-plum-600 has-checked:text-amber-400",
                                ]}
                                title="Ajouter à mon programme"
                              >
                                <input type="checkbox" data-fav value={id} class="sr-only" />
                                <Icon name="star" class="size-5 group-has-checked/fav:fill-current" />
                                <span class="sr-only">Ajouter « {t.title} » à mon programme</span>
                              </label>
                          )}

                          <h3
                            class:list={[
                              "pr-8 font-bold text-balance",
                              (t.keynote || t.topic || t.advanced || inRoom) && "mt-3",
                              featured ? "text-xl sm:text-2xl" : "text-lg leading-snug text-plum-800",
                            ]}
                          >
                            {t.title}
                          </h3>

                          {t.speakers.length > 0 && (
                            <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
                              {t.speakers.map((s) => (
                                <li>
                                  <span
                                    class:list={[
                                      "inline-flex items-center gap-2 text-sm font-semibold",
                                      featured ? "text-white/90" : "text-plum-600",
                                    ]}
                                  >
                                    <span
                                      aria-hidden="true"
                                      class:list={[
                                        "grid size-6 place-items-center rounded-full text-[0.6rem] font-bold",
                                        featured ? "bg-white/20" : "bg-plum-100",
                                      ]}
                                    >
                                      {s
                                        .split(/[\s-]+/)
                                        .map((p) => p[0])
                                        .slice(0, 2)
                                        .join("")}
                                    </span>
                                    {s}
                                  </span>
                                </li>
                              ))}
                            </ul>
                          )}

                          {t.video && (
                            <div class="mt-auto pt-4 print:hidden">
                              <a
                                href={t.video}
                                target="_blank"
                                rel="noopener noreferrer"
                                class:list={[
                                  "inline-flex items-center gap-2 rounded-full px-3.5 py-2 text-sm font-semibold transition",
                                  featured
                                    ? "bg-white text-plum-700 hover:bg-plum-50"
                                    : "bg-plum-600 text-white hover:bg-plum-700",
                                ]}
                              >
                                <Icon name="youtube" class="size-4.5" />
                                Voir la vidéo
                                <span class="sr-only">de « {t.title} » sur YouTube</span>
                              </a>
                            </div>
                          )}

                          <p
                            class:list={[
                              "flex flex-wrap items-center gap-x-3 gap-y-1 text-xs",
                              t.video ? "pt-3" : "mt-auto pt-4",
                              featured ? "text-white/70" : "text-plum-950/50",
                              !ownTime && "md:hidden",
                            ]}
                          >
                            <span class:list={[!ownTime && "md:hidden"]}>
                              <time datetime={dt(t.start)}>{formatTime(t.start)}</time> –{" "}
                              <time datetime={dt(t.end)}>{formatTime(t.end)}</time> · {minutes(t.start, t.end)} min
                            </span>
                            {!inRoom && <span class="md:hidden">Toutes les salles</span>}
                          </p>
                        </article>
                      );
                    })}
                  </div>
                );
              })()}
            </div>
          </li>
        );
      })
    }
  </ol>

  {
    edition.notes && (
      <ul class="mt-8 space-y-1 text-sm text-plum-950/60">
        {edition.notes.map((n) => (
          <li>{n}</li>
        ))}
      </ul>
    )
  }
</div>

<style>
  /* Keep each parallel talk in its room's column. */
  @media (min-width: 48rem) {
    .parallel > [data-room="1"] {
      grid-column-start: 2;
    }
  }

  [data-row][data-past] {
    opacity: 0.55;
  }
  [data-row][data-current] .talk:not([hidden]) {
    box-shadow: 0 0 0 3px var(--color-lilac-400);
  }

  @media print {
    .talk {
      break-inside: avoid;
      box-shadow: none !important;
    }
  }
</style>

<script>
  /** Current wall-clock time in Paris, as { date: "YYYY-MM-DD", time: "HH:MM" }. ?now=YYYY-MM-DDTHH:MM overrides it. */
  function parisNow() {
    const override = new URLSearchParams(location.search).get("now");
    if (override) return { date: override.slice(0, 10), time: override.slice(11, 16) };
    const parts = Object.fromEntries(
      new Intl.DateTimeFormat("en-CA", {
        timeZone: "Europe/Paris",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
      })
        .formatToParts(new Date())
        .map((p) => [p.type, p.value]),
    );
    return { date: `${parts.year}-${parts.month}-${parts.day}`, time: `${parts.hour}:${parts.minute}` };
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-programme]")) {
    const rows = [...root.querySelectorAll<HTMLElement>("[data-row]")];
    const storageKey = `polycloud:favs:${root.dataset.year}`;

    // Favourites: persisted per edition in localStorage
    let favs = new Set<string>();
    try {
      favs = new Set(JSON.parse(localStorage.getItem(storageKey) ?? "[]"));
    } catch {}
    for (const box of root.querySelectorAll<HTMLInputElement>("[data-fav]")) box.checked = favs.has(box.value);

    root.addEventListener("change", (e) => {
      const box = e.target as HTMLInputElement;
      if (!box.matches("[data-fav]")) return;
      box.checked ? favs.add(box.value) : favs.delete(box.value);
      try {
        localStorage.setItem(storageKey, JSON.stringify([...favs]));
      } catch {}
    });

    // Live "now" marker on the day of the event
    function markNow() {
      const now = parisNow();
      if (now.date !== root.dataset.date) return;
      for (const row of rows) {
        const current = row.dataset.start! <= now.time && now.time < row.dataset.end!;
        row.toggleAttribute("data-current", current);
        row.toggleAttribute("data-past", row.dataset.end! <= now.time);
        row.querySelector<HTMLElement>("[data-now-badge]")!.hidden = !current;
      }
    }
    markNow();
    setInterval(markNow, 30_000);
  }
</script>
