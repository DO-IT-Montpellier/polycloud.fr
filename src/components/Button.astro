---
import Icon, { type IconName } from "./Icon.astro";
import { url } from "../lib/url";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "light" | "ghost-light";
  icon?: IconName;
  external?: boolean;
  download?: boolean;
  class?: string;
}

const { href, variant = "primary", icon, external, download, class: className } = Astro.props;

const variants = {
  primary: "bg-plum-600 text-white shadow-lg shadow-plum-600/25 hover:bg-plum-700",
  secondary: "bg-white text-plum-700 ring-1 ring-plum-200 hover:ring-plum-400 hover:bg-plum-50",
  light: "bg-white text-plum-700 hover:bg-plum-50",
  "ghost-light": "text-white ring-1 ring-white/40 hover:bg-white/10 hover:ring-white",
};
---

<a
  href={url(href)}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  download={download || undefined}
  class:list={[
    "group inline-flex items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition duration-200",
    variants[variant],
    className,
  ]}
>
  {icon && <Icon name={icon} class="size-4.5 shrink-0" />}
  <slot />
</a>
