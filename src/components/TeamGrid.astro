---
import Icon from "./Icon.astro";
import type { TeamMember } from "../data/editions";

interface Props {
  members: TeamMember[];
  class?: string;
}

const { members: team, class: className } = Astro.props;

const initials = (name: string) =>
  name
    .split(/[\s-]+/)
    .filter((p) => p[0] === p[0].toUpperCase())
    .map((p) => p[0])
    .slice(0, 2)
    .join("");
---

<ul class:list={["grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5", className]}>
  {
    team.map((m, i) => {
      const Tag = m.linkedin ? "a" : "div";
      return (
        <li>
          <Tag
            {...(m.linkedin
              ? {
                  href: m.linkedin,
                  target: "_blank",
                  rel: "noopener noreferrer",
                }
              : {})}
            class:list={[
              "group flex h-full flex-col items-center rounded-3xl bg-white p-6 text-center ring-1 ring-plum-900/5 transition duration-300",
              m.linkedin &&
                "hover:-translate-y-1 hover:shadow-xl hover:shadow-plum-600/10 hover:ring-plum-200",
            ]}
          >
            <span
              class:list={[
                "grid size-20 place-items-center rounded-full text-xl font-bold tracking-wide",
                i % 2
                  ? "bg-lilac-400/20 text-lilac-500"
                  : "bg-plum-100 text-plum-600",
              ]}
              aria-hidden="true"
            >
              {initials(m.name)}
            </span>
            <span class="mt-4 font-bold text-plum-800">{m.name}</span>
            <span class="mt-1 text-sm text-plum-950/60">{m.role}</span>
            {m.linkedin && (
              <span class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-plum-600 opacity-60 transition group-hover:opacity-100">
                <Icon name="linkedin" class="size-3.5" />
                LinkedIn
              </span>
            )}
          </Tag>
        </li>
      );
    })
  }
</ul>
