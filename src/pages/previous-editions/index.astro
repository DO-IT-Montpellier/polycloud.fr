---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import {
  currentEdition,
  editions,
  formatDate,
  speakersOf,
  talksOf,
} from "../../data/editions";
import { links } from "../../data/site";
import { url } from "../../lib/url";

const past = editions.filter((e) => e.year !== currentEdition.year);

const editionHref = (year: number) =>
  url(year === currentEdition.year ? "/programme" : `/previous-editions/${year}`);

// Speakers who came back for more than one edition, most loyal first
const appearances = new Map<string, number[]>();
for (const e of editions)
  for (const s of speakersOf(e))
    appearances.set(s, [...(appearances.get(s) ?? []), e.year]);
const returning = [...appearances]
  .filter(([, years]) => years.length > 1)
  .sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
---

<Layout
  title="Éditions antérieures"
  description="Les programmes des précédentes éditions de Polycloud, depuis 2022."
>
  <PageHero eyebrow="Depuis 2022" title="Éditions antérieures">
    <p>
      Quatre éditions avant celle-ci, et une communauté qui grandit chaque
      année. Parcourez les programmes passés, et retrouvez les rediffusions sur
      notre chaîne YouTube.
    </p>
    <div class="mt-8">
      <Button href={links.youtube} icon="play" external>Chaîne YouTube</Button>
    </div>
  </PageHero>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ol class="grid gap-5 md:grid-cols-2">
      {
        past.map((e) => {
          const talks = talksOf(e).filter((t) => t.speakers.length > 0);
          return (
            <li>
              <a
                href={editionHref(e.year)}
                class="group flex h-full flex-col rounded-[2rem] bg-white p-7 ring-1 ring-plum-900/5 transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-plum-600/10 hover:ring-plum-200 sm:p-8"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-xs font-bold tracking-logo text-lilac-500 uppercase">
                      {e.ordinal}
                    </p>
                    <h2 class="mt-2 text-xl font-bold text-plum-700">
                      <time datetime={e.date}>{formatDate(e.date)}</time>
                    </h2>
                  </div>
                  <span class="text-5xl leading-none font-bold text-plum-100 transition group-hover:text-plum-200">
                    {e.year}
                  </span>
                </div>

                <dl class="mt-6 flex gap-6 text-sm">
                  <div>
                    <dt class="text-plum-950/50">Talks</dt>
                    <dd class="text-2xl font-bold text-plum-700">
                      {talks.length}
                    </dd>
                  </div>
                  <div>
                    <dt class="text-plum-950/50">Speakers</dt>
                    <dd class="text-2xl font-bold text-plum-700">
                      {speakersOf(e).length}
                    </dd>
                  </div>
                </dl>

                <ul class="mt-6 space-y-2 border-t border-plum-900/5 pt-5 text-sm text-plum-950/70">
                  {talks.slice(0, 3).map((t) => (
                    <li class="flex gap-2">
                      <span class="mt-2 size-1.5 shrink-0 rounded-full bg-lilac-400" />
                      <span>
                        <span class="font-semibold text-plum-800">
                          {t.title}
                        </span>
                        <span class="text-plum-950/50">
                          {" "}
                          - {t.speakers.join(", ")}
                        </span>
                      </span>
                    </li>
                  ))}
                  <li class="pl-3.5 text-plum-950/50">
                    et {talks.length - 3} autres…
                  </li>
                </ul>

                <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-plum-600">
                  Voir l’édition
                  <Icon
                    name="arrow-right"
                    class="size-4 transition group-hover:translate-x-1"
                  />
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  {
    returning.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 lg:px-8">
        <p class="text-xs font-bold tracking-logo text-lilac-500 uppercase">
          Ils reviennent
        </p>
        <h2 class="mt-3 text-3xl font-bold text-plum-700 sm:text-4xl">
          Nos speakers fidèles
        </h2>
        <p class="mt-4 max-w-2xl text-plum-950/70">
          Merci à celles et ceux qui sont revenus partager leur savoir, édition
          après édition.
        </p>
        <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {returning.map(([name, years]) => (
            <li class="flex items-center justify-between gap-4 rounded-2xl bg-white px-5 py-4 ring-1 ring-plum-900/5">
              <span class="font-semibold text-plum-800">{name}</span>
              <span class="flex flex-wrap justify-end gap-1">
                {years
                  .slice()
                  .sort()
                  .map((y) => (
                    <a
                      href={editionHref(y)}
                      class="rounded-full bg-plum-50 px-2 py-0.5 text-xs font-bold text-plum-600 transition hover:bg-plum-600 hover:text-white"
                      aria-label={`${name} en ${y}`}
                    >
                      '{String(y).slice(2)}
                    </a>
                  ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
