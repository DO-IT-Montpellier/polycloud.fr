---
import CloudMark from "./CloudMark.astro";

interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="relative overflow-hidden">
  <CloudMark class="pointer-events-none absolute -top-10 -right-24 h-72 w-auto text-plum-600/[0.06] sm:-right-10 sm:h-96" />
  <div class="relative mx-auto max-w-7xl px-4 pt-16 pb-12 sm:px-6 sm:pt-24 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-logo text-lilac-500">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight text-balance text-plum-700 sm:text-5xl">{title}</h1>
    <div class="mt-6 max-w-2xl text-lg leading-relaxed text-plum-950/75">
      <slot />
    </div>
  </div>
</section>
