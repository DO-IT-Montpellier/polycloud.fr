---
import CloudMark from "./CloudMark.astro";
import MobileNav from "./MobileNav";
import { event, links, nav } from "../data/site";
import { route, url } from "../lib/url";

const currentPath = route(Astro.url.pathname);

// Resolved once for both the desktop nav and the mobile menu
const items = nav.map((item) => ({
  ...item,
  href: url(item.href),
  active: item.href === currentPath || currentPath.startsWith(`${item.href}/`),
}));
---

<header
  class="sticky top-0 z-50 border-b border-plum-900/5 bg-mist/85 backdrop-blur-md"
>
  <div
    class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8"
  >
    <a
      href={url("/")}
      class="relative z-50 flex items-center gap-2.5 text-plum-600"
      aria-label="Polycloud - accueil"
    >
      <CloudMark class="h-8 w-auto" />
      <span class="text-lg font-bold tracking-logo">POLYCLOUD</span>
    </a>

    <nav
      aria-label="Navigation principale"
      class="hidden items-center gap-3 lg:flex"
    >
      {
        [
          items.filter((i) => i.secondary),
          items.slice(1).filter((i) => !i.secondary),
        ].map((group, g) => (
          <>
            {g > 0 && (
              <span aria-hidden="true" class="h-5 w-px bg-plum-900/15" />
            )}
            <ul class="flex items-center gap-1">
              {group.map(({ href, label, active }) => {
                return (
                  <li>
                    <a
                      href={href}
                      aria-current={active ? "page" : undefined}
                      class:list={[
                        "rounded-full px-3 py-2 text-sm font-semibold transition",
                        active
                          ? "bg-plum-100 text-plum-700"
                          : "text-plum-900/70 hover:bg-plum-100/60 hover:text-plum-700",
                      ]}
                    >
                      {label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {
        event.ended ? (
          <a
            href={links.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden rounded-full bg-plum-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-plum-700 sm:inline-flex"
          >
            Rediffusions
          </a>
        ) : (
          <a
            href={links.tickets}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden rounded-full bg-plum-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-plum-700 sm:inline-flex"
          >
            Billetterie
          </a>
        )
      }
      <MobileNav
        client:media="(max-width: 1023px)"
        items={items}
        cta={event.ended
          ? { label: "Voir les rediffusions", href: links.youtube }
          : { label: "Billetterie", href: links.tickets }}
      />
    </div>
  </div>
</header>

<script>
  import { route, url } from "../lib/url";

  // On the home page, links to "/" scroll back up instead of reloading, and drop any #anchor from the URL
  document.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>(
      `a[href="${url("/")}"]`,
    );
    if (
      !link ||
      route(location.pathname) !== "/" ||
      e.metaKey ||
      e.ctrlKey ||
      e.shiftKey ||
      e.button !== 0
    )
      return;
    e.preventDefault();
    window.scrollTo({ top: 0 });
    if (location.hash) history.pushState(null, "", url("/"));
  });
</script>
