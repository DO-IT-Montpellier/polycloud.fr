---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { cfpStatusOf, currentEdition as edition, formatDay } from "../data/editions";
import { socials } from "../data/site";

const formats = [
  {
    duration: "30",
    label: "minutes",
    text: "Un format court et efficace pour présenter un sujet, un retour d'expérience ou une découverte.",
  },
  {
    duration: "50",
    label: "minutes",
    text: "Un talk plus approfondi, pour entrer dans le détail et aller plus loin.",
  },
];

const levels = [
  {
    name: "Beginner",
    text: "Pour faire découvrir un sujet à un public curieux, sans prérequis.",
  },
  {
    name: "Advanced",
    text: "Pour celles et ceux qui veulent creuser, avec un public déjà initié.",
  },
];

const benefits = [
  {
    title: "Partager votre expertise",
    text: "Sur des sujets variés comme le développement, l'infrastructure, la sécurité, la data science, la virtualisation et bien plus encore.",
  },
  {
    title: "Apporter une vision unique",
    text: "Sur le cloud et le DevOps, des domaines en pleine évolution, et aider les étudiant·e·s et jeunes professionnel·le·s à mieux les comprendre.",
  },
  {
    title: "Inspirer et guider",
    text: "La prochaine génération de talents du cloud, en partageant cas pratiques, méthodes et bonnes pratiques apprises au fil de votre parcours.",
  },
  {
    title: "Faire partie d'une communauté",
    text: "Les speakers de Polycloud sont aussi des mentors, des pionniers et des passionnés qui rendent cet événement inoubliable.",
  },
];

const cfp = edition.cfp;
const cfpStatus = cfpStatusOf(edition) ?? "closed";
const linkedin = socials.find((s) => s.network === "linkedin")!;
---

<Layout
  title="Devenir speaker"
  description="Proposez un talk à Polycloud, la conférence Cloud & DevOps de Polytech Montpellier."
>
  <PageHero eyebrow="Speakers" title="Devenir speaker">
    <p>
      Venez partager votre expérience et vos connaissances avec la
      communauté&nbsp;! Devenir speaker à Polycloud, c'est bien plus que faire
      une présentation&nbsp;: c'est l'opportunité de partager vos découvertes
      avec une communauté curieuse et passionnée.
    </p>
  </PageHero>

  <section
    class="mx-auto grid max-w-7xl gap-5 px-4 sm:px-6 lg:grid-cols-2 lg:px-8"
  >
    <div class="rounded-3xl bg-white p-8 ring-1 ring-plum-900/5">
      <h2 class="text-xs font-bold uppercase tracking-logo text-lilac-500">
        Deux formats
      </h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          formats.map((f) => (
            <li class="rounded-2xl bg-plum-50 p-5">
              <p class="text-plum-600">
                <span class="text-4xl font-bold">{f.duration}</span>
                <span class="ml-1 font-semibold">{f.label}</span>
              </p>
              <p class="mt-2 text-sm leading-relaxed text-plum-950/70">
                {f.text}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-3xl bg-white p-8 ring-1 ring-plum-900/5">
      <h2 class="text-xs font-bold uppercase tracking-logo text-lilac-500">
        Deux niveaux de public
      </h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          levels.map((l) => (
            <li class="rounded-2xl bg-plum-50 p-5">
              <p class="inline-flex rounded-full bg-plum-600 px-3 py-1 text-sm font-bold text-white">
                {l.name}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-plum-950/70">
                {l.text}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Pourquoi nous rejoindre"
      title="Être speaker, c'est aussi…"
    />
    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        benefits.map((b, i) => (
          <li class="rounded-3xl bg-white p-7 ring-1 ring-plum-900/5">
            <span class="text-sm font-bold text-lilac-400">0{i + 1}</span>
            <h3 class="mt-3 text-lg font-bold text-plum-700">{b.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-plum-950/70">
              {b.text}
            </p>
          </li>
        ))
      }
    </ol>
    <p class="mt-10 max-w-3xl text-lg leading-relaxed text-plum-950/75">
      Que vous présentiez un projet innovant, une nouvelle technologie ou une
      approche atypique, devenir speaker à Polycloud, c'est vivre une expérience
      enrichissante dans une ambiance stimulante et bienveillante.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 lg:px-8">
    <div
      class="flex flex-col items-start gap-8 rounded-[2rem] bg-plum-600 p-8 text-white sm:p-12 md:flex-row md:items-center md:justify-between"
    >
      <div class="flex items-start gap-5">
        <span
          class="grid size-14 shrink-0 place-items-center rounded-2xl bg-white text-plum-600"
        >
          <Icon name="mic" class="size-7" />
        </span>
        <div>
          <h2 class="text-2xl font-bold">
            Envie de rejoindre l'aventure&nbsp;?
          </h2>
          <p class="mt-2 max-w-xl text-white/80">
            {cfpStatus === "soon" && (
              <>
                Le Call for Papers (CFP) de l'édition {edition.year} ouvrira le{" "}
                <strong class="text-white">{formatDay(cfp!.opens)}</strong>&nbsp;: préparez votre talk&nbsp;!
              </>
            )}
            {cfpStatus === "open" && (
              <>
                Le Call for Papers (CFP) de l'édition {edition.year} est ouvert
                {cfp!.closes && (
                  <>
                    {" "}jusqu'au <strong class="text-white">{formatDay(cfp!.closes)}</strong>
                  </>
                )}
                &nbsp;: proposez votre talk et partagez votre passion&nbsp;!
              </>
            )}
            {cfpStatus === "closed" && (
              <>
                Le Call for Papers (CFP) de l'édition {edition.year} est clos. L'ouverture du prochain sera annoncée sur
                nos réseaux&nbsp;: suivez-nous pour ne pas le manquer&nbsp;!
              </>
            )}
          </p>
        </div>
      </div>
      {
        cfpStatus === "open" && cfp?.url ? (
          <a
            href={cfp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 rounded-full bg-white px-6 py-3 font-semibold text-plum-700 transition hover:bg-plum-50"
          >
            Proposer un talk
          </a>
        ) : cfpStatus === "closed" ? (
          <a
            href={linkedin.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white px-6 py-3 font-semibold text-plum-700 transition hover:bg-plum-50"
          >
            <Icon name="linkedin" class="size-5" />
            Suivre sur LinkedIn
          </a>
        ) : (
          <span class="shrink-0 rounded-full bg-white/15 px-6 py-3 font-semibold text-white/80 ring-1 ring-white/25">
            {cfpStatus === "soon" ? "Bientôt ouvert" : "CFP ouvert"}
          </span>
        )
      }
    </div>
  </section>
</Layout>
