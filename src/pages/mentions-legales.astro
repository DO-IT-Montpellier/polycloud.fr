---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { sponsorForm } from "../data/site";

const publisher = {
  name: "DO IT Montpellier",
  form: "Association loi 1901",
  address: ["190 rue Claude Nougaro, Apt 601", "34090 Montpellier"],
  rna: "W343034357",
  email: "contact@polycloud.fr",
  phone: "+33 7 81 09 31 51",
  president: "Dorian RICHARD",
};

const host = {
  name: "GitHub Pages",
  company: "GitHub, Inc.",
  address: [
    "88 Colin P. Kelly Jr. Street",
    "San Francisco, CA 94107",
    "États-Unis",
  ],
  // GitHub has no general phone line; this is the number it gives for enterprise sales
  phone: "+1 877 448 4820",
  href: "https://pages.github.com/",
};

// Runs the partner form's API and database (see DO-IT-Montpellier/cloudflare)
const formHost = {
  name: "Cloudflare",
  company: "Cloudflare, Inc.",
  address: ["101 Townsend Street", "San Francisco, CA 94107", "États-Unis"],
  phone: "+1 650 319 8930",
  href: "https://www.cloudflare.com/",
};

// "+33 1 23 45 67 89" -> "tel:+33123456789"
const tel = (phone: string) => `tel:${phone.replace(/[^+\d]/g, "")}`;

const link =
  "font-semibold text-plum-600 underline decoration-lilac-400 decoration-2 underline-offset-4 hover:decoration-plum-600";
---

<Layout
  title="Mentions légales"
  description="Mentions légales, politique de confidentialité et cookies du site Polycloud."
>
  <PageHero eyebrow="Informations légales" title="Mentions légales" />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex max-w-3xl flex-col gap-5">
      <section
        aria-labelledby="editeur"
        class="rounded-3xl bg-white p-7 ring-1 ring-plum-900/5 sm:p-9"
      >
        <h2 id="editeur" class="text-xl font-bold text-plum-700">
          Éditeur du site
        </h2>
        <dl
          class="mt-5 grid gap-x-8 gap-y-4 text-plum-950/80 sm:grid-cols-[11rem_1fr]"
        >
          <dt class="font-semibold text-plum-800">Dénomination</dt>
          <dd>{publisher.form} « {publisher.name} »</dd>

          <dt class="font-semibold text-plum-800">Siège social</dt>
          <dd>
            <address class="not-italic">
              {
                publisher.address.map((line) => (
                  <span class="block">{line}</span>
                ))
              }
            </address>
          </dd>

          <dt class="font-semibold text-plum-800">Numéro RNA</dt>
          <dd>{publisher.rna}</dd>

          <dt class="font-semibold text-plum-800">
            Directeur de la publication
          </dt>
          <dd>{publisher.president}, président</dd>

          <dt class="font-semibold text-plum-800">Contact</dt>
          <dd>
            <a
              href={`mailto:${publisher.email}`}
              class="font-semibold text-plum-600 underline decoration-lilac-400 decoration-2 underline-offset-4 hover:decoration-plum-600"
              >{publisher.email}</a
            >
          </dd>

          <dt class="font-semibold text-plum-800">Téléphone</dt>
          <dd>
            <a
              href={tel(publisher.phone)}
              class="font-semibold text-plum-600 underline decoration-lilac-400 decoration-2 underline-offset-4 hover:decoration-plum-600"
              >{publisher.phone}</a
            >
          </dd>
        </dl>
      </section>

      <section
        aria-labelledby="hebergeur"
        class="rounded-3xl bg-white p-7 ring-1 ring-plum-900/5 sm:p-9"
      >
        <h2 id="hebergeur" class="text-xl font-bold text-plum-700">
          Hébergement
        </h2>
        <p class="mt-5 leading-relaxed text-plum-950/80">
          Le site est hébergé par{" "}
          <a
            href={host.href}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-plum-600 underline decoration-lilac-400 decoration-2 underline-offset-4 hover:decoration-plum-600"
            >{host.name}</a
          >, un service de {host.company}
        </p>
        <address class="mt-3 text-plum-950/70 not-italic">
          {host.address.map((line) => <span class="block">{line}</span>)}
          <span class="mt-2 block">
            Téléphone&nbsp;:{" "}
            <a href={tel(host.phone)} class="underline decoration-plum-200 underline-offset-4 hover:decoration-plum-600"
              >{host.phone}</a
            >
          </span>
        </address>
        <p class="mt-6 leading-relaxed text-plum-950/80">
          Le formulaire «&nbsp;Devenir partenaire&nbsp;» et sa base de données sont hébergés par{" "}
          <a href={formHost.href} target="_blank" rel="noopener noreferrer" class={link}>{formHost.name}</a>, un
          service de {formHost.company}. La base de données du formulaire est stockée dans l'Union européenne.
        </p>
        <address class="mt-3 text-plum-950/70 not-italic">
          {formHost.address.map((line) => <span class="block">{line}</span>)}
          <span class="mt-2 block">
            Téléphone&nbsp;:{" "}
            <a href={tel(formHost.phone)} class="underline decoration-plum-200 underline-offset-4 hover:decoration-plum-600"
              >{formHost.phone}</a
            >
          </span>
        </address>
      </section>

      <section
        aria-labelledby="confidentialite"
        class="rounded-3xl bg-white p-7 ring-1 ring-plum-900/5 sm:p-9"
      >
        <h2 id="confidentialite" class="text-xl font-bold text-plum-700">
          Politique de confidentialité
        </h2>
        <div class="mt-5 space-y-4 leading-relaxed text-plum-950/80">
          <p>
            Ce site n'utilise aucun outil de mesure d'audience. Notre hébergeur, GitHub, conserve l'adresse IP des
            visiteurs dans ses journaux techniques pour assurer la sécurité du
            service (voir sa{" "}
            <a
              href="https://docs.github.com/fr/site-policy/privacy-policies/github-general-privacy-statement"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-plum-600 underline decoration-lilac-400 decoration-2 underline-offset-4 hover:decoration-plum-600"
              >politique de confidentialité</a
            >).
          </p>
          <p>
            Les noms des intervenants sont publiés avec leur accord dans le
            cadre du programme.
          </p>

          <h3 id="formulaire-partenaires" class="pt-2 text-lg font-bold text-plum-700">
            Formulaire «&nbsp;Devenir partenaire&nbsp;»
          </h3>
          <dl class="grid gap-x-8 gap-y-3 sm:grid-cols-[11rem_1fr]">
            <dt class="font-semibold text-plum-800">Responsable</dt>
            <dd>
              {publisher.form} «&nbsp;{publisher.name}&nbsp;», joignable à{" "}
              <a href={`mailto:${sponsorForm.email}`} class={link}>{sponsorForm.email}</a>.
            </dd>

            <dt class="font-semibold text-plum-800">Finalité</dt>
            <dd>Traiter votre demande de partenariat et préparer la convention de sponsoring.</dd>

            <dt class="font-semibold text-plum-800">Base légale</dt>
            <dd>Mesures précontractuelles prises à votre demande (article 6.1.b du RGPD).</dd>

            <dt class="font-semibold text-plum-800">Données</dt>
            <dd>
              Les champs du formulaire&nbsp;: entreprise, site web, nom, fonction, e-mail, téléphone, taille de la
              structure, palier et options souhaités, engagement sur deux ans, participation en 2026, message. Les champs marqués d'un astérisque sont obligatoires
              pour traiter la demande. Ni votre adresse IP ni votre navigateur ne sont enregistrés avec la demande.
            </dd>

            <dt class="font-semibold text-plum-800">Destinataires</dt>
            <dd>
              L'équipe partenariats de Polycloud, et nos sous-traitants&nbsp;: Cloudflare (hébergement de la base de
              données, protection anti-robot) et Mailgun, un service de Sinch (envoi de l'e-mail de notification à
              l'équipe, depuis sa région européenne).
            </dd>

            <dt class="font-semibold text-plum-800">Localisation</dt>
            <dd>
              La base de données des demandes est stockée dans l'Union européenne. Une copie de chaque demande est
              envoyée par e-mail à l'équipe ({sponsorForm.email}). Cloudflare et Mailgun appartiennent à des groupes
              établis hors de l'UE&nbsp;: Cloudflare adhère au Data Privacy Framework UE–États-Unis, et Mailgun est
              encadré par les clauses contractuelles types de la Commission européenne.
            </dd>

            <dt class="font-semibold text-plum-800">Durée</dt>
            <dd>
              3 ans après votre demande. La base de données est purgée automatiquement&nbsp;; les e-mails de
              notification sont supprimés de notre messagerie dans le même délai.
            </dd>

            <dt class="font-semibold text-plum-800">Vos droits</dt>
            <dd>
              Accès, rectification, effacement, limitation et opposition, en écrivant à{" "}
              <a href={`mailto:${sponsorForm.email}`} class={link}>{sponsorForm.email}</a>.
            </dd>
          </dl>
          <p>
            Pour toute demande relative à vos données (accès, rectification,
            suppression), écrivez à{" "}
            <a
              href={`mailto:${publisher.email}`}
              class="font-semibold text-plum-600 underline decoration-lilac-400 decoration-2 underline-offset-4 hover:decoration-plum-600"
              >{publisher.email}</a
            >. Vous pouvez également adresser une réclamation à la{" "}
            <a
              href="https://www.cnil.fr/fr/adresser-une-plainte"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-plum-600 underline decoration-lilac-400 decoration-2 underline-offset-4 hover:decoration-plum-600"
              >CNIL</a
            >.
          </p>
        </div>
      </section>

      <section
        aria-labelledby="cookies"
        class="rounded-3xl bg-white p-7 ring-1 ring-plum-900/5 sm:p-9"
      >
        <h2 id="cookies" class="text-xl font-bold text-plum-700">Cookies</h2>
        <p class="mt-5 leading-relaxed text-plum-950/80">
          Ce site n'utilise aucun cookie ni traceur soumis à consentement. Seuls
          les talks que vous ajoutez à vos favoris sont enregistrés localement
          dans votre navigateur.
        </p>
        <p class="mt-4 leading-relaxed text-plum-950/80">
          Sur la page <a href="/partenaires" class={link}>Devenir partenaire</a> uniquement, la protection anti-robot
          Cloudflare Turnstile peut déposer un cookie technique (<code>cf_clearance</code>) et lit des signaux
          techniques (adresse IP, navigateur) dans le seul but de bloquer les robots. Cloudflare le classe comme
          strictement nécessaire&nbsp;: il ne requiert donc pas votre consentement.
        </p>
      </section>
    </div>
  </div>
</Layout>
