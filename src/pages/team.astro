---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TeamGrid from "../components/TeamGrid.astro";
import { currentEdition } from "../data/editions";
import { links } from "../data/site";

const team = currentEdition.team ?? [];

const missions = [
  "Organiser et financer des événements autour de l'informatique, Polycloud en tête",
  "Donner un coup de pouce aux étudiant·e·s qui se déplacent pour apprendre ou rencontrer des pros",
  "Faire se rencontrer étudiant·e·s et professionnel·le·s",
  "Soutenir toutes les initiatives étudiantes qui vont dans ce sens",
];
---

<Layout
  title="L'équipe"
  description="Polycloud est organisée par DO IT Montpellier, une association d'étudiant·e·s en informatique de Polytech Montpellier."
>
  <PageHero
    eyebrow="À propos de nous"
    title="Une asso étudiante derrière Polycloud"
  >
    <p>
      Polycloud est organisée par{" "}
      <strong class="font-semibold text-plum-700">DO IT Montpellier</strong>,
      une association créée par des étudiant·e·s en informatique de Polytech
      Montpellier pour faire vivre la conférence… et bien d'autres projets.
    </p>
  </PageHero>

  <section
    class="mx-auto grid max-w-7xl gap-5 px-4 sm:px-6 lg:grid-cols-[1.3fr_1fr] lg:px-8"
  >
    <div
      class="rounded-3xl bg-white p-8 leading-relaxed text-plum-950/75 ring-1 ring-plum-900/5 sm:p-10"
    >
      <h2 class="text-xs font-bold uppercase tracking-logo text-lilac-500">
        D'où on vient
      </h2>
      <p class="mt-5">
        De 2022 à 2026, Polycloud a été portée par les apprenti·e·s de la{" "}
        <a
          href={links.devopsCourse}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-plum-600 underline decoration-lilac-400 decoration-2 underline-offset-4 hover:decoration-plum-600"
          >filière DO</a
        >{" "}
        de Polytech Montpellier, dans le cadre de leur formation. Cinq éditions
        plus tard, on a voulu donner à l'aventure un cadre à elle.
      </p>
      <p class="mt-5">
        C'est comme ça qu'est née{" "}
        <strong class="text-plum-700">DO IT Montpellier</strong>&nbsp;: une
        association qui soutient les projets des
        étudiant·e·s des formations d'ingénieur en informatique de Polytech
        Montpellier. Polycloud reste notre grand rendez-vous de l'année, mais
        ce n'est pas le seul&nbsp;!
      </p>
    </div>
    <div class="rounded-3xl bg-plum-600 p-8 text-white sm:p-10">
      <h2 class="text-xs font-bold uppercase tracking-logo text-lilac-300">
        Ce que fait l'asso
      </h2>
      <ul class="mt-6 space-y-4">
        {
          missions.map((m) => (
            <li class="flex gap-3 leading-relaxed text-white/85">
              <span class="mt-2.5 size-2 shrink-0 rounded-full bg-lilac-400" />
              {m}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow={`${team.length} membres`}
      title="L'équipe Polycloud"
    />
    <TeamGrid members={team} class="mt-10" />
  </section>
</Layout>
