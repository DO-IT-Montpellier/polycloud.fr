---
interface Props {
  eyebrow?: string;
  title: string;
  align?: "left" | "center";
  tone?: "dark" | "light";
  class?: string;
}

const { eyebrow, title, align = "left", tone = "dark", class: className } = Astro.props;
---

<div class:list={[align === "center" && "mx-auto text-center", "max-w-3xl", className]}>
  {
    eyebrow && (
      <p
        class:list={[
          "mb-3 text-xs font-bold uppercase tracking-logo",
          tone === "dark" ? "text-lilac-500" : "text-lilac-300",
        ]}
      >
        {eyebrow}
      </p>
    )
  }
  <h2
    class:list={[
      "text-3xl font-bold leading-tight text-balance sm:text-4xl",
      tone === "dark" ? "text-plum-700" : "text-white",
    ]}
  >
    {title}
  </h2>
  <slot />
</div>
