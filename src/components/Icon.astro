---
// Minimal 24px stroke icon set, so the site needs no icon dependency.
export type IconName =
  | "linkedin"
  | "x"
  | "instagram"
  | "youtube"
  | "plane"
  | "train"
  | "car"
  | "tram"
  | "ticket"
  | "download"
  | "play"
  | "map-pin"
  | "arrow-right"
  | "external"
  | "calendar"
  | "clock"
  | "mic"
  | "users"
  | "newspaper"
  | "lightbulb"
  | "cloud"
  | "lock"
  | "chip"
  | "server"
  | "database"
  | "gauge"
  | "cpu"
  | "gear"
  | "smartphone"
  | "flame"
  | "star"
  | "search"
  | "calendar-plus";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "size-5" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  {name === "linkedin" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="3" />
      <path d="M8 11v6M8 7.5v.01M12 17v-6M12 13.5a2.5 2.5 0 0 1 5 0V17" />
    </>
  )}
  {name === "x" && <path d="M4 4h4.5L20 20h-4.5zM4 20l6.5-6.5M13.5 10.5 20 4" />}
  {name === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.5 6.5v.01" />
    </>
  )}
  {name === "youtube" && (
    <>
      <rect x="2" y="5" width="20" height="14" rx="4" />
      <path d="m10 9 5 3-5 3z" fill="currentColor" />
    </>
  )}
  {name === "plane" && (
    <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z" />
  )}
  {name === "train" && (
    <>
      <rect x="5" y="3" width="14" height="14" rx="3" />
      <path d="M5 11h14M12 3v8M8 21l2-4M16 21l-2-4M8.5 14h.01M15.5 14h.01" />
    </>
  )}
  {name === "car" && (
    <>
      <path d="M5 17H3v-5l2-5h14l2 5v5h-2M5 12h14" />
      <circle cx="7.5" cy="17" r="2" />
      <circle cx="16.5" cy="17" r="2" />
    </>
  )}
  {name === "tram" && (
    <>
      <rect x="6" y="6" width="12" height="12" rx="2" />
      <path d="M6 13h12M9 2h6M12 2v4M9 21l1-3M15 21l-1-3M9.5 15.5h.01M14.5 15.5h.01" />
    </>
  )}
  {name === "ticket" && (
    <>
      <path d="M3 8a2 2 0 0 0 2-2h14a2 2 0 0 0 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 0-2 2H5a2 2 0 0 0-2-2v-2a2 2 0 0 0 0-4z" />
      <path d="M13 6v2M13 11v2M13 16v2" />
    </>
  )}
  {name === "download" && <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />}
  {name === "play" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m10 8.5 5 3.5-5 3.5z" fill="currentColor" />
    </>
  )}
  {name === "map-pin" && (
    <>
      <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0" />
      <circle cx="12" cy="10" r="3" />
    </>
  )}
  {name === "arrow-right" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "external" && <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />}
  {name === "calendar" && (
    <>
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 10h18M8 3v4M16 3v4" />
    </>
  )}
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === "mic" && (
    <>
      <rect x="9" y="2" width="6" height="12" rx="3" />
      <path d="M5 11a7 7 0 0 0 14 0M12 18v4" />
    </>
  )}
  {name === "users" && (
    <>
      <circle cx="9" cy="8" r="4" />
      <path d="M2 21a7 7 0 0 1 14 0M16 4a4 4 0 0 1 0 8M22 21a7 7 0 0 0-4-6.3" />
    </>
  )}
  {name === "newspaper" && (
    <>
      <path d="M4 4h13v16H6a2 2 0 0 1-2-2zM17 8h3v10a2 2 0 0 1-2 2" />
      <path d="M8 8h5M8 12h5M8 16h3" />
    </>
  )}
  {name === "lightbulb" && <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.6.6 1 1.4 1 2.5h6c0-1.1.4-1.9 1-2.5A6 6 0 0 0 12 3" />}
  {name === "cloud" && <path d="M7 18a4.5 4.5 0 0 1-.6-9A6 6 0 0 1 18 9.5a4.3 4.3 0 0 1-.5 8.5z" />}
  {name === "lock" && (
    <>
      <rect x="4" y="11" width="16" height="10" rx="2" />
      <path d="M8 11V7a4 4 0 0 1 8 0v4" />
    </>
  )}
  {name === "chip" && (
    <>
      <rect x="6" y="6" width="12" height="12" rx="2" />
      <path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" />
    </>
  )}
  {name === "server" && (
    <>
      <rect x="3" y="4" width="18" height="7" rx="2" />
      <rect x="3" y="13" width="18" height="7" rx="2" />
      <path d="M7 7.5h.01M7 16.5h.01" />
    </>
  )}
  {name === "database" && (
    <>
      <ellipse cx="12" cy="5" rx="8" ry="3" />
      <path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
    </>
  )}
  {name === "gauge" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m12 12 4-4M7 15.5a6 6 0 0 1 10 0" />
    </>
  )}
  {name === "cpu" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="M7 9h4v6H7zM14 9h3M14 12h3M14 15h3M7 2v3M12 2v3M17 2v3" />
    </>
  )}
  {name === "gear" && (
    <>
      <circle cx="12" cy="12" r="3" />
      <path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1 7 17M17 7l2.1-2.1" />
    </>
  )}
  {name === "smartphone" && (
    <>
      <rect x="6" y="2" width="12" height="20" rx="2.5" />
      <path d="M11 18h2" />
    </>
  )}
  {name === "flame" && (
    <path d="M12 22a7 7 0 0 0 7-7c0-4-3-6.5-4-10-2 2-3 4-3 6-1-1-2-2-2.5-3.5C7.5 9.5 5 12 5 15a7 7 0 0 0 7 7" />
  )}
  {name === "star" && (
    <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z" />
  )}
  {name === "search" && (
    <>
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-4-4" />
    </>
  )}
  {name === "calendar-plus" && (
    <>
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5" />
    </>
  )}
</svg>
