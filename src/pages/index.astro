---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import CloudMark from "../components/CloudMark.astro";
import CloudSkyline from "../components/CloudSkyline.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SponsorTiers from "../components/SponsorTiers.astro";
import { currentEdition } from "../data/editions";
import { event, links, topics, venue } from "../data/site";
import { url } from "../lib/url";

const facts = [
  { value: `${event.edition}e`, label: "édition" },
  { value: "100 %", label: "gratuit" },
  { value: "8h30–19h", label: "de talks et d'échanges" },
  { value: "Cloud", label: "et DevOps au programme" },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute top-24 -left-6 hidden h-40 w-56 text-plum-600/15 bg-dots lg:block"
    >
    </div>
    <div
      class="mx-auto grid max-w-7xl items-center gap-12 px-4 pt-12 pb-10 sm:px-6 sm:pt-20 lg:grid-cols-[1.1fr_1fr] lg:px-8"
    >
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-plum-700 ring-1 ring-plum-200"
        >
          <span class="size-2 rounded-full bg-lilac-400"></span>
          Édition {event.year}
        </p>

        <h1
          class="mt-6 text-4xl font-bold tracking-logo text-plum-600 min-[420px]:text-5xl sm:text-6xl xl:text-7xl"
        >
          POLYCLOUD
        </h1>
        <p class="mt-3 text-2xl font-medium text-lilac-400 sm:text-3xl">
          You don't know the cloud
        </p>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-plum-950/75">
          La conférence tech autour du <strong
            class="font-semibold text-plum-800">Cloud</strong
          > et du{" "}
          <strong class="font-semibold text-plum-800">DevOps</strong>, organisée
          par des étudiant·e·s.
        </p>

        <dl
          class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold text-plum-800"
        >
          <div class="flex items-center gap-2">
            <dt class="sr-only">Date</dt>
            <Icon name="calendar" class="size-5 text-lilac-400" />
            <dd>{event.date}</dd>
          </div>
          <div class="flex items-center gap-2">
            <dt class="sr-only">Lieu</dt>
            <Icon name="map-pin" class="size-5 text-lilac-400" />
            <dd>{event.venue}</dd>
          </div>
          <div class="flex items-center gap-2">
            <dt class="sr-only">Horaires</dt>
            <Icon name="clock" class="size-5 text-lilac-400" />
            <dd>{event.hours.replace(" à ", " – ")}</dd>
          </div>
        </dl>

        <div class="mt-10 flex flex-wrap gap-3">
          {
            event.ended ? (
              <Button href={links.youtube} icon="play" external>
                Voir les rediffusions
              </Button>
            ) : (
              <Button href={links.tickets} icon="ticket" external>
                Billetterie
              </Button>
            )
          }
          <Button href="/programme" variant="secondary" icon="calendar">
            Voir le programme
          </Button>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
        <div
          class="pointer-events-none absolute -right-4 -bottom-6 h-32 w-44 text-lilac-400/40 bg-dots"
        >
        </div>
        <div
          class="relative overflow-hidden rounded-[2rem] shadow-2xl shadow-plum-900/20 ring-1 ring-plum-900/10"
        >
          <img
            src={url("/images/promodo4-3.webp")}
            alt="Un amphithéâtre de Polytech Montpellier rempli lors d'une conférence Polycloud"
            width="750"
            height="450"
            class="aspect-[5/3] w-full object-cover"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-plum-900/50 via-transparent"
          >
          </div>
        </div>
        <div
          class="absolute -top-6 -left-4 grid size-24 place-items-center rounded-3xl bg-plum-600 shadow-xl shadow-plum-600/30 sm:-left-8 sm:size-28"
        >
          <CloudMark class="h-12 w-auto text-white sm:h-14" />
        </div>
      </div>
    </div>

    <CloudSkyline class="mt-6" />
  </section>

  <!-- Status band -->
  <section class="bg-plum-600 text-white">
    <div
      class="relative mx-auto -mt-2 max-w-7xl px-4 pb-16 sm:-mt-6 sm:px-6 md:-mt-10 lg:px-8"
    >
      {
        event.ended && (
          <div class="flex flex-col items-start gap-6 rounded-3xl bg-white/10 p-6 ring-1 ring-white/15 sm:p-8 md:flex-row md:items-center md:justify-between">
            <div class="flex items-start gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-white text-plum-600">
                <Icon name="youtube" class="size-6" />
              </span>
              <div>
                <p class="text-lg font-bold">
                  Les conférences {event.year} sont terminées.
                </p>
                <p class="mt-1 text-white/80">
                  Ne soyez pas triste, toutes les rediffusions sont disponibles
                  sur notre chaîne YouTube :)
                </p>
              </div>
            </div>
            <Button
              href={links.youtube}
              variant="light"
              icon="play"
              external
              class="shrink-0"
            >
              Voir les rediffusions
            </Button>
          </div>
        )
      }

      <dl class="mt-12 grid grid-cols-2 gap-8 text-center md:grid-cols-4">
        {
          facts.map((f) => (
            <div>
              <dt class="sr-only">{f.label}</dt>
              <dd>
                <span class="block text-3xl font-bold sm:text-4xl">
                  {f.value}
                </span>
                <span class="mt-1 block text-sm text-white/70">{f.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- About -->
  <section class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2">
      <SectionHeading
        eyebrow="Polycloud"
        title="Une journée pour découvrir le cloud, par des étudiant·e·s."
      />
      <div class="space-y-5 text-lg leading-relaxed text-plum-950/75">
        <p>
          <strong class="font-semibold text-plum-700">Polycloud</strong> est une journée
          de conférences gratuites qui tiendra sa <strong
            class="font-semibold text-plum-700"
            >{event.editionLabel} édition</strong
          > le {event.date.toLowerCase()} à{" "}
          {event.venue}. Le but&nbsp;: faire découvrir le monde du cloud et du
          DevOps, au travers de conférences et d'activités pratiques.
        </p>
        <p>
          Retrouvez les replays des talks 2025 sur{" "}
          <a
            href={links.replays2025}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-plum-600 underline decoration-lilac-400 decoration-2 underline-offset-4 hover:decoration-plum-600"
            >notre playlist YouTube</a
          > pour ne rien manquer de cette aventure enrichissante.
        </p>
      </div>
    </div>

    <!-- Audience -->
    <div class="mt-16 grid gap-5 md:grid-cols-2">
      <article class="rounded-3xl bg-white p-8 ring-1 ring-plum-900/5">
        <span
          class="grid size-12 place-items-center rounded-2xl bg-plum-100 text-plum-600"
        >
          <Icon name="users" class="size-6" />
        </span>
        <h3 class="mt-6 text-xl font-bold text-plum-700">
          Étudiant·e ou passionné·e&nbsp;?
        </h3>
        <p class="mt-3 leading-relaxed text-plum-950/75">
          Venez (re)découvrir des technologies et concepts qui vous permettront
          de mieux comprendre les enjeux du cloud.
        </p>
      </article>
      <article class="rounded-3xl bg-white p-8 ring-1 ring-plum-900/5">
        <span
          class="grid size-12 place-items-center rounded-2xl bg-lilac-400/20 text-lilac-500"
        >
          <Icon name="mic" class="size-6" />
        </span>
        <h3 class="mt-6 text-xl font-bold text-plum-700">
          Professionnel·le&nbsp;?
        </h3>
        <p class="mt-3 leading-relaxed text-plum-950/75">
          Échangez, partagez votre savoir et passez un moment agréable à
          discuter autour de la tech&nbsp;!
        </p>
      </article>
    </div>
  </section>

  <!-- Programme -->
  <section class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 lg:px-8">
    <div
      class="relative overflow-hidden rounded-[2rem] bg-plum-900 px-6 py-14 text-white sm:px-12 sm:py-16"
    >
      <CloudMark
        class="pointer-events-none absolute -right-16 -bottom-20 h-80 w-auto text-white/5"
      />
      <div
        class="relative grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-center"
      >
        <div>
          <SectionHeading
            eyebrow="Programme"
            title="Un programme riche et varié"
            tone="light"
          >
            <p class="mt-5 text-lg leading-relaxed text-white/75">
              Grâce à l'intervention d'experts habitués des grandes conférences
              comme Devoxx ou KubeCon, une multitude de sujets sont abordés tout
              au long de la journée.
            </p>
          </SectionHeading>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href="/programme" variant="light" icon="calendar">
              Voir le programme
            </Button>
            <Button href="/previous-editions" variant="ghost-light">
              Éditions précédentes
              <Icon
                name="arrow-right"
                class="size-4 transition group-hover:translate-x-0.5"
              />
            </Button>
          </div>
        </div>
        <ul class="flex flex-wrap gap-2.5" aria-label="Thématiques">
          {
            topics.map((t) => (
              <li class="rounded-full bg-white/10 px-4 py-2 text-sm font-semibold ring-1 ring-white/15">
                {t}
              </li>
            ))
          }
          <li class="rounded-full bg-lilac-400 px-4 py-2 text-sm font-semibold">
            et bien plus encore…
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Sponsors -->
  {
    currentEdition.sponsors && (
      <section
        id="sponsors"
        class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 lg:px-8"
      >
        <SectionHeading
          eyebrow="Ils nous soutiennent"
          title="Nos sponsors"
          align="center"
          class="mb-12"
        >
          <p class="mt-4 text-plum-950/70">
            Polycloud est une conférence gratuite, organisée par des
            étudiant·e·s. Elle n'existerait pas sans le soutien de ces
            entreprises et institutions. Merci à elles&nbsp;!
          </p>
        </SectionHeading>
        <SponsorTiers tiers={currentEdition.sponsors} />
      </section>
    )
  }

  <!-- Access -->
  <section
    id="informations"
    class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 lg:px-8"
  >
    <SectionHeading eyebrow="Accès" title="Accéder à la conférence">
      <p class="mt-5 text-lg leading-relaxed text-plum-950/75">
        La conférence se tient le <strong class="font-semibold text-plum-700"
          >{event.date.toLowerCase()}</strong
        > de{" "}
        {event.hours} dans les locaux de {event.venue}. Pensez à vous munir du
        billet reçu lors de votre inscription.
      </p>
    </SectionHeading>

    <div class="mt-12 grid gap-5 lg:grid-cols-[1fr_1.15fr]">
      <div class="flex flex-col gap-5">
        <address class="rounded-3xl bg-plum-600 p-8 not-italic text-white">
          <div class="flex items-center gap-3">
            <Icon name="map-pin" class="size-6 text-lilac-300" />
            <p class="text-lg font-bold">{venue.name}</p>
          </div>
          <p class="mt-4 leading-relaxed text-white/80">
            {venue.lines.map((l) => <span class="block">{l}</span>)}
          </p>
          <Button
            href={links.maps}
            variant="light"
            icon="external"
            external
            class="mt-6"
          >
            Voir sur Google Maps
          </Button>
        </address>

        <ul class="grid gap-3 sm:grid-cols-2">
          {
            venue.transport.map((t) => (
              <li class="rounded-3xl bg-white p-6 ring-1 ring-plum-900/5">
                <span class="grid size-10 place-items-center rounded-xl bg-plum-100 text-plum-600">
                  <Icon name={t.icon} class="size-5" />
                </span>
                <p class="mt-4 font-bold text-plum-700">{t.mode}</p>
                {t.details.map((d) => (
                  <p class="mt-1 text-sm leading-relaxed text-plum-950/70">
                    {d}
                  </p>
                ))}
              </li>
            ))
          }
        </ul>
      </div>

      <a
        href={url("/images/plan.jpg")}
        target="_blank"
        rel="noopener"
        class="group relative flex items-center overflow-hidden rounded-3xl bg-white p-3 ring-1 ring-plum-900/5"
      >
        <img
          src={url("/images/plan.jpg")}
          alt="Plan d'accès au bâtiment 31 du campus Triolet"
          loading="lazy"
          class="h-auto w-full rounded-2xl transition duration-500 group-hover:scale-[1.02]"
        />
        <span
          class="absolute right-6 bottom-6 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1.5 text-xs font-semibold text-plum-700 shadow"
        >
          <Icon name="external" class="size-3.5" />
          Agrandir le plan
        </span>
      </a>
    </div>
  </section>
</Layout>
